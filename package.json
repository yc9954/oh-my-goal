{
  "name": "oh-my-goal",
  "version": "0.18.29",
  "description": "Codex goal-native autonomy harness with annealing backpressure",
  "type": "module",
  "main": "dist/cli/omg-main.js",
  "bin": {
    "oh-my-goal": "dist/cli/omg.js",
    "omg": "dist/cli/omg.js"
  },
  "scripts": {
    "build": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true});\" && tsc && node -e \"const fs=require('fs'); fs.chmodSync('dist/cli/omg.js', 0o755);\"",
    "check:no-unused": "tsc -p tsconfig.no-unused.json",
    "dev": "tsc --watch",
    "lint": "biome lint src",
    "prepare": "node src/scripts/prepare-git-build.js",
    "prepack": "npm run build && npm run verify:plugin-bundle",
    "test:plugin": "node --test dist/cli/__tests__/oh-my-goal-plugin.test.js",
    "test:package": "node --test dist/cli/__tests__/package-bin-contract.test.js dist/scripts/__tests__/smoke-packed-install.test.js",
    "test:goal": "node --test dist/cli/__tests__/goal-harness.test.js dist/goal-harness/__tests__/*.test.js dist/goal-workflows/__tests__/*.test.js",
    "test:node": "npm run test:plugin && npm run test:package && npm run test:goal",
    "test": "npm run build && npm run verify:plugin-bundle && npm run test:node",
    "smoke:packed-install": "node dist/scripts/smoke-packed-install.js",
    "sync:plugin": "node dist/scripts/verify-oh-my-goal-plugin.js",
    "sync:plugin:check": "node dist/scripts/verify-oh-my-goal-plugin.js",
    "verify:plugin-bundle": "node dist/scripts/verify-oh-my-goal-plugin.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/cli/omg.*",
    "dist/cli/omg-main.*",
    "dist/cli/goal-harness.*",
    "dist/goal-harness/*.js",
    "dist/goal-harness/*.js.map",
    "dist/goal-harness/*.d.ts",
    "dist/goal-harness/*.d.ts.map",
    "dist/goal-workflows/*.js",
    "dist/goal-workflows/*.js.map",
    "dist/goal-workflows/*.d.ts",
    "dist/goal-workflows/*.d.ts.map",
    "dist/hooks/task-size-detector.*",
    "dist/scripts/verify-oh-my-goal-plugin.*",
    "plugins/oh-my-goal/",
    ".agents/plugins/marketplace.json"
  ],
  "keywords": [
    "codex",
    "openai",
    "cli",
    "agents",
    "orchestration",
    "multi-agent"
  ],
  "author": "yc9954",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yc9954/oh-my-goal.git"
  },
  "homepage": "https://github.com/yc9954/oh-my-goal#readme",
  "bugs": {
    "url": "https://github.com/yc9954/oh-my-goal/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/node": "^26.1.2",
    "c8": "^11.0.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "ajv": ">=8.18.0",
    "hono": ">=4.11.10"
  }
}
